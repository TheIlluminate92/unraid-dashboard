      if (disk.usagePercent != null) detailField(fields, 'Used', percent(number(disk.usagePercent)) + ' · ' + bytes(number(disk.usedBytes)));
      if (disk.device) detailField(fields, 'Device', disk.device);
      var smart = disk.smart || {};
