    </header>
    <div id="waz-workloads-alert" class="waz-workloads-alert" hidden></div>
    <details class="waz-secondary-panel"><summary>Workload details <span id="waz-workloads-collapsed-summary">Connecting…</span></summary>

    <div class="waz-workloads-summary" aria-label="Docker summary" data-layout-group="summary" data-layout-columns="3">
      <div data-layout-item="running" data-layout-label="CONTAINERS RUNNING"><span>CONTAINERS RUNNING</span><strong id="waz-workloads-running">--</strong></div>
      <div data-layout-item="vdisk" data-layout-label="DOCKER VDISK"><span>DOCKER VDISK</span><strong id="waz-workloads-docker">--</strong></div>
      <div data-layout-item="updates" data-layout-label="UPDATES"><span>UPDATES</span><strong id="waz-workloads-updates">--</strong></div>
      <div data-layout-item="gpu" data-layout-label="GPU CLIENTS"><span>GPU CLIENTS</span><strong id="waz-workloads-gpu">--</strong></div>
    </div>

    <div data-layout-group="sections">
    <section class="waz-workloads-section waz-folder-section" data-layout-item="folders" data-layout-label="Folders">
      <div class="waz-workloads-section-head"><b>DOCKER FOLDERS</b><span id="waz-folder-count">--</span></div>
      <div id="waz-folder-tabs" class="waz-folder-tabs"></div>
    </section>

    <section class="waz-workloads-section waz-container-section" data-layout-item="containers" data-layout-label="Containers">
      <div class="waz-workloads-section-head"><b id="waz-container-section-title">CONTAINERS</b><span id="waz-container-count">--</span></div>
      <div id="waz-container-grid" class="waz-container-grid"><span class="waz-workloads-muted">Loading containers…</span></div>
    </section>

    <section class="waz-workloads-section waz-top-process-section" data-layout-item="processes" data-layout-label="Top processes">
      <div class="waz-workloads-section-head"><b>TOP PROCESSES</b><span>LIVE CPU · HOST + DOCKER</span></div>
      <div class="waz-process-head"><span>PROCESS</span><span>OWNER</span><span>CPU</span><span>RAM</span></div>
      <div id="waz-top-processes" class="waz-process-list"><span class="waz-workloads-muted">Taking first process sample…</span></div>
    </section>

    <section class="waz-workloads-section waz-inspector-section" data-layout-item="inspector" data-layout-label="Container details">
      <header class="waz-inspector-header">
        <span id="waz-selected-icon" class="waz-selected-icon"><i class="fa fa-cube"></i></span>
        <span class="waz-inspector-title"><b id="waz-selected-name">SELECT A CONTAINER</b><small id="waz-selected-state">Click an icon above for live details and native controls</small></span>
        <span id="waz-selected-badge" class="waz-selected-badge">IDLE</span>
      </header>

      <div class="waz-selected-metrics">
        <div><span>CPU</span><strong id="waz-selected-cpu">--</strong></div>
        <div><span>RAM</span><strong id="waz-selected-memory">--</strong></div>
        <div><span>NETWORK</span><strong id="waz-selected-network">--</strong></div>
        <div><span>DISK I/O</span><strong id="waz-selected-disk">--</strong></div>
        <div><span>GPU</span><strong id="waz-selected-gpu">--</strong></div>
      </div>

      <div class="waz-selected-charts">
        <div><span>CPU</span><svg viewBox="0 0 180 34" preserveAspectRatio="none"><polyline id="waz-selected-cpu-line"></polyline></svg></div>
        <div><span>NETWORK</span><svg viewBox="0 0 180 34" preserveAspectRatio="none"><polyline id="waz-selected-network-line"></polyline></svg></div>
        <div><span>DISK</span><svg viewBox="0 0 180 34" preserveAspectRatio="none"><polyline id="waz-selected-disk-line"></polyline></svg></div>
      </div>

      <div class="waz-selected-detail-grid">
        <div><b>POOL ACCESS</b><span id="waz-selected-pools">--</span></div>
        <div><b>NETWORK</b><span id="waz-selected-addresses">--</span></div>
        <div><b>STATUS</b><span id="waz-selected-detail">--</span></div>
      </div>

    </section>

    </div>
    </details>
    <footer class="waz-workloads-footer"><span id="waz-workloads-updated">Waiting for first snapshot</span><span>v0.8.5</span></footer>
  </section>
  <div id="iframe-popup" style="display:none;-webkit-overflow-scrolling:touch"></div>
</td></tr>
</tbody>
EOT;
?>

<link rel="stylesheet" href="/plugins/waz.dashboard/assets/css/layout.css?v=2026.10.24.08">
<link rel="stylesheet" href="/plugins/waz.dashboard/assets/css/workloads.css?v=2026.10.24.08">
<link rel="stylesheet" href="/plugins/waz.dashboard/assets/css/polish.css?v=2026.10.24.08">
<script src="/plugins/dynamix.docker.manager/javascript/docker.js?v=2026.10.24.08"></script>
<script defer src="/plugins/waz.dashboard/assets/js/layout.js?v=2026.10.24.08"></script>
<script defer src="/plugins/waz.dashboard/assets/js/workloads.js?v=2026.10.24.08"></script>

]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e

RUNTIME_DIR="/usr/local/emhttp/plugins/.waz.dashboard.staged"
CONFIG_DIR="/boot/config/plugins/waz.dashboard"
CONFIG_FILE="$CONFIG_DIR/waz.dashboard.cfg"
LEGACY_HEALTH_CONFIG="/boot/config/plugins/waz.health/waz.health.cfg"
LEGACY_HEALTH_PLUGIN="/boot/config/plugins/waz.health.plg"

chmod 0644 "$RUNTIME_DIR/WazDashboard.page" "$RUNTIME_DIR/WazWorkloads.page" "$RUNTIME_DIR/WazStorage.page" "$RUNTIME_DIR/WazHealthBanner.page"
chmod 0644 "$RUNTIME_DIR/assets/css/system.css" "$RUNTIME_DIR/assets/css/workloads.css" "$RUNTIME_DIR/assets/css/storage.css" "$RUNTIME_DIR/assets/css/banner.css"
chmod 0644 "$RUNTIME_DIR/assets/js/system.js" "$RUNTIME_DIR/assets/js/workloads.js" "$RUNTIME_DIR/assets/js/storage.js" "$RUNTIME_DIR/assets/js/banner.js"
chmod 0644 "$RUNTIME_DIR/include/metrics.php" "$RUNTIME_DIR/include/workloads.php" "$RUNTIME_DIR/include/storage.php" "$RUNTIME_DIR/include/gpu-sampler.php" "$RUNTIME_DIR/include/health.php" "$RUNTIME_DIR/include/status.php"
chmod 0755 "$RUNTIME_DIR/scripts/start.sh" "$RUNTIME_DIR/scripts/stop.sh"
chmod 0644 "$RUNTIME_DIR/images/waz.dashboard.png" "$RUNTIME_DIR/images/waz.dashboard.svg"
php -r '$image = getimagesize($argv[1]); if (!$image || $image[0] !== 256 || $image[1] !== 256 || $image[2] !== IMAGETYPE_PNG) exit(1);' "$RUNTIME_DIR/images/waz.dashboard.png"

php -l "$RUNTIME_DIR/include/metrics.php" >/dev/null
php -l "$RUNTIME_DIR/include/workloads.php" >/dev/null
php -l "$RUNTIME_DIR/include/storage.php" >/dev/null
php -l "$RUNTIME_DIR/include/gpu-sampler.php" >/dev/null
php -l "$RUNTIME_DIR/include/health.php" >/dev/null
php -l "$RUNTIME_DIR/include/status.php" >/dev/null

for SHELL_FILE in "$RUNTIME_DIR"/scripts/*.sh; do bash -n "$SHELL_FILE"; done

# Staged validation must complete before stopping the installed processes.
STAGED_DIR="$RUNTIME_DIR"
RUNTIME_DIR="/usr/local/emhttp/plugins/waz.dashboard"
PREVIOUS_DIR="/usr/local/emhttp/plugins/.waz.dashboard.previous"
[ ! -L "$RUNTIME_DIR" ] && [ ! -L "$PREVIOUS_DIR" ] || exit 1
HAD_PREVIOUS=false
ACTIVATING=false
rollback_runtime() {
  local result=$?
  if [ "$result" -ne 0 ] && [ "$ACTIVATING" = true ]; then
    # A failed new start must be stopped before a previous writer is restored.
    if [ -x "$RUNTIME_DIR/scripts/stop.sh" ] && ! "$RUNTIME_DIR/scripts/stop.sh"; then
      echo "New runtime could not stop; previous runtime retained for supervised recovery." >&2
      return
    fi
    rm -rf -- "$RUNTIME_DIR"
    if $HAD_PREVIOUS; then
      mv -- "$PREVIOUS_DIR" "$RUNTIME_DIR"
      "$RUNTIME_DIR/scripts/start.sh" || true
    fi
    echo "Plugin activation failed; prior runtime restored when available." >&2
  fi
}
trap rollback_runtime EXIT
if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then "$RUNTIME_DIR/scripts/stop.sh"; fi
# Keep a previous successful runtime until the next activation. Never touch config.
if [ -d "$RUNTIME_DIR" ]; then
  rm -rf -- "$PREVIOUS_DIR"
  mv -- "$RUNTIME_DIR" "$PREVIOUS_DIR"
  HAD_PREVIOUS=true
fi
ACTIVATING=true
mv -- "$STAGED_DIR" "$RUNTIME_DIR"

if [ ! -f "$CONFIG_FILE" ]; then
  cat > "$CONFIG_FILE" <<'WAZ_CONFIG'
DISPLAY_NAME="auto"
PRIMARY_INTERFACE="bond0"
GPU_CARD="auto"
GPU_RECENT_SECONDS="5"
OVERALL_STATE="normal"
OVERALL_MESSAGE=""
ARRAY_STATE="normal"
ARRAY_MESSAGE=""
STORAGE_STATE="normal"
STORAGE_MESSAGE=""
COOLING_STATE="normal"
COOLING_MESSAGE=""
UPS_STATE="normal"
UPS_MESSAGE=""
STORAGE_WARN_PERCENT="95"
STORAGE_FAULT_PERCENT="98"
CPU_WARN_C="60"
CPU_FAULT_C="70"
COOLANT_WARN_C="35"
COOLANT_FAULT_C="40"
FLOW_WARN_LPH="130"
FLOW_FAULT_LPH="120"
THROTTLE_LATCH_SECONDS="300"
UPS_LOAD_WARN_PERCENT="90"
UPS_LOAD_FAULT_PERCENT="100"
WAZ_CONFIG
fi

for DEFAULT in \
  'DISPLAY_NAME="auto"' \
  'PRIMARY_INTERFACE="bond0"' \
  'GPU_CARD="auto"' \
  'GPU_RECENT_SECONDS="5"' \
  'OVERALL_STATE="normal"' \
  'OVERALL_MESSAGE=""' \
  'ARRAY_STATE="normal"' \
  'ARRAY_MESSAGE=""' \
  'STORAGE_STATE="normal"' \
  'STORAGE_MESSAGE=""' \
  'COOLING_STATE="normal"' \
  'COOLING_MESSAGE=""' \
  'UPS_STATE="normal"' \
  'UPS_MESSAGE=""' \
  'STORAGE_WARN_PERCENT="95"' \
  'STORAGE_FAULT_PERCENT="98"' \
  'CPU_WARN_C="60"' \
  'CPU_FAULT_C="70"' \
  'COOLANT_WARN_C="35"' \
  'COOLANT_FAULT_C="40"' \
  'FLOW_WARN_LPH="130"' \
  'FLOW_FAULT_LPH="120"' \
  'THROTTLE_LATCH_SECONDS="300"' \
  'UPS_LOAD_WARN_PERCENT="90"' \
  'UPS_LOAD_FAULT_PERCENT="100"'; do
  KEY="${DEFAULT%%=*}"
  if ! grep -q "^${KEY}=" "$CONFIG_FILE"; then
    LEGACY_VALUE=""
    if [ -f "$LEGACY_HEALTH_CONFIG" ]; then
      LEGACY_VALUE="$(grep -m1 "^${KEY}=" "$LEGACY_HEALTH_CONFIG" 2>/dev/null || true)"
    fi
    printf '%s\n' "${LEGACY_VALUE:-$DEFAULT}" >> "$CONFIG_FILE"
  fi
done

chmod 0644 "$CONFIG_FILE"
mkdir -p /var/run/waz.dashboard
rm -f "/var/tmp/waz-health-throttle-state.json"

if [ -f "$LEGACY_HEALTH_PLUGIN" ]; then
  mv -f "$LEGACY_HEALTH_PLUGIN" "${LEGACY_HEALTH_PLUGIN}.disabled"
fi
rm -rf "/usr/local/emhttp/plugins/waz.health"

"$RUNTIME_DIR/scripts/start.sh"
trap - EXIT

echo "WAZ Dashboard v0.8.5 installed with integrated Health banner. Reload the Unraid WebUI to display it."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
RUNTIME_DIR="/usr/local/emhttp/plugins/waz.dashboard"

if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh" || true
fi
rm -rf "$RUNTIME_DIR"
rm -rf "/var/run/waz.dashboard"
rm -rf "/usr/local/emhttp/plugins/.waz.dashboard.staged" "/usr/local/emhttp/plugins/.waz.dashboard.previous"
rm -f "/boot/config/plugins/waz.dashboard.plg"
echo "WAZ System removed. Persistent settings were retained in /boot/config/plugins/waz.dashboard. Reload the Dashboard to clear the panel."
]]>
</INLINE>
</FILE>
</PLUGIN>
