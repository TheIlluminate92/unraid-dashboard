t5/bz+3n9nP7uf3cfm4/t5/bz+3n9nP7uf3cfm4/t5/bz+3n9nP7uf3cfm4/t5/bz+3n9nP7+Ud9
/n9wW2AOACgFAA==
RACKLINE_PAYLOAD
printf '%s  %s\n' '996f03fcd7d37c95f2ae6dd5e2faf522d06fbf08db3e0d320186f7be44ced49d' "$stage/payload.tgz" | sha256sum -c -
cat > "$stage/expected" <<'RACKLINE_MANIFEST'
rackline.dashboard/Rackline.page
rackline.dashboard/RacklineDashboard.page
rackline.dashboard/assets/css/rackline.css
rackline.dashboard/assets/js/app.js
rackline.dashboard/assets/js/model.js
rackline.dashboard/images/rackline.dashboard.svg
rackline.dashboard/include/containers.php
rackline.dashboard/include/io.php
rackline.dashboard/include/metrics.php
rackline.dashboard/include/smart-capture-lib.php
rackline.dashboard/include/smart-capture-report.php
rackline.dashboard/include/smart-capture-state.php
rackline.dashboard/include/smart-capture.php
rackline.dashboard/include/smart-report.php
rackline.dashboard/include/storage.php
rackline.dashboard/include/view.php
rackline.dashboard/include/workloads.php
RACKLINE_MANIFEST
tar -tzf "$stage/payload.tgz" > "$stage/actual"
cmp "$stage/expected" "$stage/actual" || { echo 'Unexpected Rackline archive paths'; exit 1; }
# The build accepts regular files only. Independently reject links and special files.
tar -tvzf "$stage/payload.tgz" | awk 'substr($0,1,1) != "-" { bad=1 } END { exit bad }'
mkdir "$stage/extracted"
tar -xzf "$stage/payload.tgz" -C "$stage/extracted" --no-same-owner --no-same-permissions
candidate="$stage/extracted/rackline.dashboard"
for required in Rackline.page RacklineDashboard.page include/view.php include/metrics.php include/storage.php include/smart-report.php include/smart-capture-lib.php include/smart-capture.php include/smart-capture-report.php include/smart-capture-state.php include/workloads.php include/io.php include/containers.php images/rackline.dashboard.svg assets/js/model.js assets/js/app.js assets/css/rackline.css; do
    test -s "$candidate/$required" || { echo "Incomplete Rackline runtime: $required"; exit 1; }
done
while IFS= read -r -d '' file; do php -l "$file" >/dev/null; done < <(find "$candidate" -type f \( -name '*.php' -o -name '*.page' \) -print0)
# Recover the predecessor on an interrupted/failed activation when possible.
restore_previous() {
    if [ ! -e "$runtime" ] && [ -d "$stage/previous-runtime" ]; then
        mv -- "$stage/previous-runtime" "$runtime"
    fi
}
trap 'restore_previous' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# The retained predecessor is never overwritten, even across repeated installs.
if [ -d "$runtime" ]; then
    mv -- "$runtime" "$stage/previous-runtime"
fi
if ! mv -- "$candidate" "$runtime"; then
    if [ -d "$stage/previous-runtime" ]; then mv -- "$stage/previous-runtime" "$runtime"; fi
    echo 'Rackline activation failed; predecessor restored when present.'
    exit 1
fi
echo "Rackline 0.2.3 installed. Prior runtime (if present): $stage/previous-runtime"
echo 'Review build only. Open /Rackline. No service restart or other plugin/configuration change.'

]]></INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set -euo pipefail
exec 9>/var/lock/rackline.dashboard.lock
flock -n 9 || { echo 'Rackline operation already in progress'; exit 1; }
runtime=/usr/local/emhttp/plugins/rackline.dashboard
if [ -e "$runtime" ] || [ -L "$runtime" ]; then
    [ -d "$runtime" ] && [ ! -L "$runtime" ] || { echo 'Unsafe Rackline runtime path'; exit 1; }
    retained=$(mktemp -d /usr/local/emhttp/plugins/.rackline.dashboard.removed.XXXXXXXX)
    mv -- "$runtime" "$retained/runtime"
    echo "Rackline removed from WebUI; runtime retained at $retained/runtime. Other plugins and configuration unchanged."
fi
]]></INLINE>
</FILE>
</PLUGIN>
